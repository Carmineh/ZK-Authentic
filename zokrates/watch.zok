import "hashes/poseidon/poseidon" as poseidon;

// ZK-Authentic: Watch Circuit
// Verifica che l'utente conosca il "SecretID" che lega uno specifico orologio (definito dai suoi attributi)
// al suo Hash registrato sulla Blockchain.

def main(
    private field secretID,    // Key segreta fornita nella scatola (non rivelata)
    field modello,     // 1=Submarine, 2=Daytona, 3=Datejust
    field movimento,   // 1=Manuale, 2=Automatico, 3=Quarzo, 4=Ibrido
    field cassa,       // 1=Acciaio, 2=Titanio, 3=Oro
    field vetro,       // 1=Zaffiro
    field cinturino,   // 1=Metallo, 2=Pelle
    field quadrante    // 1=Ottone, 2=Meteorite
) -> field {
    
    // Calcoliamo l'hash che rappresenta l'orologio univoco.
    // L'hash combina la parte segreta (proof of ownership) con le caratteristiche pubbliche.
    // Questo hash deve corrispondere a quello salvato nello Smart Contract dall'Admin o dal Brand.
    
    // Poseidon gestisce input limitati (es. max 6). Dividiamo in due step.
    
    // 1. Hash degli attributi pubblici dell'orologio (6 campi)
    field attributesHash = poseidon([modello, movimento, cassa, vetro, cinturino, quadrante]);
    
    // 2. Hash finale che lega il segreto agli attributi
    field commitment = poseidon([secretID, attributesHash]);

    return commitment;
}
